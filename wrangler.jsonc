{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-commander",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "IncidentCommanderAgent",
        "name": "IncidentCommanderAgent"
      }
    ]
  },
  "workflows": [
    {
      "name": "incident-investigation",
      "binding": "INCIDENT_INVESTIGATION",
      "class_name": "IncidentInvestigationWorkflow"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["IncidentCommanderAgent"],
      "tag": "v1"
    }
  ]
}
