{
  "name": "incident-commander",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "concurrently -n web,agent -c auto \"yarn dev:web\" \"yarn dev:agent\"",
    "dev:web": "next dev",
    "dev:agent": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "build": "next build",
    "build:agent": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir .worker-dist",
    "preview:web": "opennextjs-cloudflare build && wrangler dev",
    "deploy:web": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:agent": "wrangler deploy --config worker/wrangler.jsonc",
    "types:agent": "wrangler types --config worker/wrangler.jsonc worker/env.generated.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn build && yarn build:agent",
    "ui:add": "npx shadcn@latest add",
    "ui:agent-chat": "shadcn add https://agent-elements.21st.dev/r/agent-chat.json"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@base-ui/react": "^1.0.0",
    "@cloudflare/ai-chat": "0.10.1",
    "@pierre/diffs": "^1.4.1",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.35.0",
    "agents": "0.22.0",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "lottie-react": "^3.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "workers-ai-provider": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.113.0"
  }
}
